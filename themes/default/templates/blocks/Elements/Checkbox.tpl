<div class="upform-check">
	<input type="checkbox" class="inp-cbx" name="{$name}" id="{$id}" value="{$value}"{if $checked} checked{/if}/>
	<label for="{$id}" class="cbx">
		<span>
			<svg viewBox="0 0 12 10" height="10px" width="12px"><polyline points="1.5 6 4.5 9 10.5 1"></polyline></svg>
		</span>
		<span>{$label}</span>
	</label>
</div>